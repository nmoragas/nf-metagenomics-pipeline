/*
╔══════════════════════════════════════════════════════════════════════════════╗
║  nextflow.config  —  Metagenomics Shotgun Pipeline v2.0                      ║
║  One Singularity container per process step                                  ║
╚══════════════════════════════════════════════════════════════════════════════╝
*/

// Paràmetres globals per defecte
params {
    input  = null
    outdir = "${launchDir}/resultats"
    sif_dir = "${projectDir}/sif" 
}
 
// Configuració de l'execució
process {

    // Recursos per defecte:
    cpus   = 1
    memory = '2 GB'
    time   = '30 min'
 

    // Recursos per tasca:
    withName: 'SAMPLESHEET_CHECK' {
        cpus   = 1
        memory = '1 GB'
        container = 'docker://python:3.11-slim'
    }

    withName: 'FASTQC' {
        cpus = 2
        memory = '2 GB'
        //container = "${params.sif_dir}/fastqc.sif"
        
    }

}
 
// Profiles d'execució
profiles {
 
    // Execució local (per defecte)
    standard {
        process.executor = 'local'
    }
 
    // SLURM (cluster HPC)
    slurm {
        process.executor = 'slurm'
        process.queue    = 'short'
    }
 
    // Docker
    docker {
        enabled    = true
    }
 
    // Singularity (típic en HPC)
    singularity {
        enabled    = true
        autoMounts = true
        runOptions = "--bind ${projectDir}"
    }
}
 
// Carpeta de treball de Nextflow (fitxers temporals)
workDir = "${launchDir}/work"
 
// Informe d'execució
report {
    enabled = true
    file    = "${params.outdir}/reports/execution_report.html"
}
 
timeline {
    enabled = true
    file    = "${params.outdir}/reports/timeline.html"
}