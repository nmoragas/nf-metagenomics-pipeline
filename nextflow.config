/*
╔══════════════════════════════════════════════════════════════════════════════╗
║  nextflow.config  —  Metagenomics Shotgun Pipeline v2.0                      ║
║  One Singularity container per process step                                  ║
╚══════════════════════════════════════════════════════════════════════════════╝

module load apps/nextflow/25.04.6

*/

// Paràmetres globals per defecte
params {
    input  = null
    outdir = "${launchDir}/resultats"
    // sif_dir = "${projectDir}/sif" 

    // ── Bowtie2 Human Removal ────────────────────
    // Ruta a l'índex bowtie2 del genoma humà (hg38)
    human_db     = "/mnt/typhon/references/human/hg38/ncbi/indexes/bowtie2/genome"
    bowtie2_extra = "--very-sensitive-local -k 1"

    // ── Clumpify dedup removal ────────────────────
    // dedupe: elimina reads duplicades
    // subs=1: permet 1 substitució al comparar reads (tolera errors de seqüenciació)
    // k=11:   longitud del kmer per detectar duplicats
    // passes=3: nombre de passades (més passades = més sensible, més lent)
    clumpify_subs   = 1
    clumpify_k      = 11
    clumpify_passes = 3


    // ── BBDuk Adapter Trimming + Quality Filter ───────────────────────────────────
    // ref: bases de dades internes de BBDuk (adapters, artifacts, phix)
    // k=25:      longitud kmer per detectar adapters
    // mink=6:    kmer mínim als extrems de la read
    // hdist=1:   permet 1 mismatch al buscar adapters
    // hdist2=0:  sense mismatches amb kmer curt (mink)
    // ktrim=r:   talla per la dreta (3' end)
    // qtrim=rl:  trimming de qualitat per ambdós extrems
    // trimq:     qualitat mínima de tall
    // minlength: longitud mínima post-trim
    bbduk_k      = 25
    bbduk_mink   = 6
    bbduk_hdist  = 1
    bbduk_hdist2 = 0
    bbduk_trimq  = 20
    bbduk_minlen = 75




}
 
// Configuració de l'execució
process {

    cpus   = 1
    memory = '2 GB'
    time   = '4 h'

    withName: 'SAMPLESHEET_CHECK' {
        cpus      = 1
        memory    = '1 GB'
        container = 'docker://python:3.11'
    }

    withName: 'FASTQC' {
        cpus      = 2
        memory    = '2 GB'
        container = 'community.wave.seqera.io/library/trim-galore:0.6.10--1bf8ca4e1967cd18'
    }

    withName: 'MULTIQC' {
        cpus      = 2
        memory    = '2 GB'
        container = 'docker://quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
    }

    withName: 'BOWTIE2_HUMAN_REMOVAL' {
        cpus      = 2
        memory    = '32 GB'
        container = 'docker://quay.io/biocontainers/bowtie2:2.5.4--he20e202_2'
    }

    withName: 'CLUMPIFY_DUPLICATE_REMOVAL' {
        cpus      = 4
        memory    = '32 GB'
        container = 'docker://quay.io/biocontainers/bbmap:39.80--h9b5c0a0_0'    
    }

    withName: 'BBDUK_TRIMMING' {
        cpus      = 4
        memory    = '32 GB'
        container = 'docker://quay.io/biocontainers/bbmap:39.80--h9b5c0a0_0'
    }

}

// Profiles d'execució
profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'odap'
    }

    docker {
        docker.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind /mnt/typhon/references/human/hg38/ncbi/indexes/bowtie2"
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.runOptions = "--bind /mnt/typhon/references/human/hg38/ncbi/indexes/bowtie2"
    }

}

// Carpeta de treball de Nextflow (fitxers temporals)
workDir = "${launchDir}/work"
 
// Informe d'execució
report {
    enabled = true
    file    = "${params.outdir}/reports/execution_report.html"
}
 
timeline {
    enabled = true
    file    = "${params.outdir}/reports/timeline.html"
}